# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Enable the YouTube Data API v3 for the project, and add
#   http://localhost:3000/api/auth/callback/google
# as an authorized redirect URI (adjust the host for your deployed domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Base URL of the deployed app. Not needed for local dev (defaults to localhost:3000).
NEXTAUTH_URL=

# OpenAI (used for playlist categorization and title-similarity embeddings)
OPENAI_API_KEY=

# Rate limiting for the "recategorize" / "refresh" actions (optional).
# Disabled by default, including in production, unless explicitly enabled.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=60
